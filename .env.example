# Copy to .env.local and fill in the blanks.
# Values already filled in were extracted from the old WordPress site's GTM
# container and HubSpot WP plugin — they are public IDs, safe to commit.

# --- HubSpot ---------------------------------------------------------------
# Portal (hub) ID. Also used by the tracking script at js.hs-scripts.com.
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=47162564

# --- Google Ads ------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18207288575
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=a38uCILvwMgcEP_Z9OlD

# --- GA4 (optional) --------------------------------------------------------
# Leave empty if there is no GA4 property. When empty, no gtag config call is
# emitted for it at all.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# --- HubSpot form GUIDs (server-side only) ---------------------------------
# Format is 8-4-4-4-12 hex, from each form's embed code. Deliberately NOT
# NEXT_PUBLIC_ — submissions go through the /api/hubspot route handler, so
# these never need to reach the browser.
HUBSPOT_FORM_GUID_QUICK_QUOTE=
HUBSPOT_FORM_GUID_DEALERS=
HUBSPOT_FORM_GUID_GET_IN_TOUCH=
