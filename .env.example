# Copy to .env.local and fill in the blanks.

# --- HubSpot ---------------------------------------------------------------
# All three come from the form's embed code:
#
#   <script src="https://js-na2.hsforms.net/forms/embed/247251136.js" defer></script>
#   <div class="hs-form-frame" data-region="na2"
#        data-form-id="2c232eee-..." data-portal-id="247251136"></div>
#
# We don't use that snippet — our own form posts to /api/hubspot — but it's
# where the values live.

# Portal (hub) ID = data-portal-id. Public, ships to the browser.
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=

# Region ("hublet") = data-region. HubSpot shards accounts across na1, na2,
# eu1... and anything other than na1 needs a region-specific API host. Leave
# empty to default to na1.
NEXT_PUBLIC_HUBSPOT_REGION=

# Form GUID = data-form-id, 8-4-4-4-12 hex. Deliberately NOT NEXT_PUBLIC_:
# submissions go through the /api/hubspot route handler, so this never reaches
# the browser. Until it's filled in, /api/hubspot returns
# 500 "HUBSPOT_FORM_GUID is not set".
#
# Used by the Dealers page form, and the Partners page hero form (same
# HubSpot form, relabeled copy — see heroFormBlock).
HUBSPOT_FORM_GUID=

# Same idea, for the Careers page hero form — a separate HubSpot form with its
# own GUID (fewer fields: no dealership/business type, no monthly volume).
# Until this is filled in, submissions from that form return
# 500 "HUBSPOT_FORM_GUID_CAREERS is not set".
HUBSPOT_FORM_GUID_CAREERS=

# Same idea, for the Contact page form (contactFormBlock) — a separate,
# simpler HubSpot form the client is setting up (name/email/phone/message).
# Until this is filled in, submissions from that form return
# 500 "HUBSPOT_FORM_GUID_CONTACT is not set".
HUBSPOT_FORM_GUID_CONTACT=

# --- Google Ads --------------------------------------------------------------
# Pulled from the old site's GTM container (GTM-PMH2Z782) and verified against
# the live Google Ads account. We call gtag directly instead of loading that
# container — see the note at the top of src/lib/tracking.js.
#
# Conversion ID. Public, ships to the browser. Left empty, no Google tag loads.
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18207288575

# Conversion label — identifies *which* action was completed. Fired from
# src/app/thank-you/page.js when someone finishes an application.
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=a38uCILvwMgcEP_Z9OlD
